---
// <Icon name="compass" />  → Linien-Icon aus Lucide (lucide.dev), direkt ins HTML eingesetzt.
// Wird beim Bauen gelesen; nur verwendete Icons landen in der Seite.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props { name: string; size?: number; class?: string }
const { name, size = 22, class: cls = '' } = Astro.props;

const require = createRequire(import.meta.url);
const raw = readFileSync(require.resolve(`lucide-static/icons/${name}.svg`), 'utf8');
const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="icon ${cls}" aria-hidden="true" focusable="false"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.6"');
---
<Fragment set:html={svg} />
