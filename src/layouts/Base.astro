---
import '../styles/global.css';
import { anker } from '../data/anker';

interface Props {
  title: string;
  description?: string;
  slug?: string; // gesetzt auf Anker-Seiten → Kopf, Weiterblättern
  eyebrow?: string;
  lead?: string;
}
const { title, description = 'Mein Klassenmanagement-System zum Nachlesen.', slug, eyebrow, lead } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (s: string) => `${base}${s}/`;
const i = slug ? anker.findIndex((a) => a.slug === slug) : -1;
const prev = i > 0 ? anker[i - 1] : null;
const next = i >= 0 && i < anker.length - 1 ? anker[i + 1] : null;
const pageTitle = slug ? `${title} · Klassenmanagement-System` : title;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <!-- Hell/Dunkel vor dem ersten Zeichnen setzen, damit nichts aufblitzt -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={base}><span class="brand-dot" aria-hidden="true"></span>Klassenmanagement</a>
        <div class="head-right">
          <nav class="nav" id="nav">
            {anker.map((a) => (
              <a href={href(a.slug)} aria-current={a.slug === slug ? 'page' : undefined}>{a.titel}</a>
            ))}
          </nav>
          <button class="icon-btn theme-toggle" type="button" aria-label="Hell oder dunkel umschalten" title="Hell / Dunkel">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <button class="icon-btn nav-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menü">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="wrap">
      {slug && (
        <section class="hero">
          <div class="eyebrow">{eyebrow ?? `Anker ${i + 1} von ${anker.length}`}</div>
          <h1>{title}</h1>
          {lead && <p class="lead">{lead}</p>}
        </section>
      )}
      <slot />
      {slug && (
        <nav class="pager" aria-label="Weiterblättern">
          {prev ? <a href={href(prev.slug)}><small>← Zurück</small>{prev.titel}</a> : <a href={base}><small>← Zurück</small>Übersicht</a>}
          {next ? <a class="next" href={href(next.slug)}><small>Weiter →</small>{next.titel}</a> : <a class="next" href={href('quellen')}><small>Weiter →</small>Quellen</a>}
        </nav>
      )}
    </main>

    <footer class="site-foot">
      <div class="wrap">
        Mein Klassenmanagement-System · laufender Entwurf, Stand {new Date().toLocaleDateString('de-AT', { month: 'long', year: 'numeric' })} · <a href={href('quellen')}>Quellen</a>
      </div>
    </footer>

    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch (e) {}
      });
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
