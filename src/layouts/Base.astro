---
import '../styles/global.css';
import { anker, gruppen, ziel, stunde, kompakt } from '../data/anker';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  slug?: string; // gesetzt auf Anker-Seiten → Kopf, Weiterblättern
  eyebrow?: string;
  lead?: string;
}
const { title, description = 'Mein Klassenmanagement-System zum Nachlesen.', slug, eyebrow, lead } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (s: string) => `${base}${s}/`;
// Weiterblättern: die neun Anker, danach das Ziel (Flow), die Stunde im Alltag, danach die Quellen.
const folge = [...anker, ziel, stunde];
const i = slug ? anker.findIndex((a) => a.slug === slug) : -1;
const f = slug ? folge.findIndex((a) => a.slug === slug) : -1;
const prev = f > 0 ? folge[f - 1] : null;
const next = f >= 0 && f < folge.length - 1 ? folge[f + 1] : null;
const heroIcon = f >= 0 ? folge[f].icon : null;
const pageTitle = slug ? `${title} · Klassenmanagement-System` : title;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#f8f6f1" />
    <!-- Hell/Dunkel vor dem ersten Zeichnen setzen, damit nichts aufblitzt -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark') t = 'light'; // Standard ist hell, dunkel nur auf Wunsch
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={base}><span class="brand-dot" aria-hidden="true"></span>Klassenmanagement</a>
        <div class="head-right">
          <nav class="nav" id="nav" aria-label="Hauptmenü">
            <div class="dd">
              <button class="dd-btn" type="button" aria-expanded="false" aria-controls="dd-panel" data-active={slug ? 'true' : undefined}>
                System <Icon name="chevron-down" size={16} class="dd-chev" />
              </button>
              <div class="dd-panel" id="dd-panel">
                {gruppen.map((g) => (
                  <div class="dd-group">
                    <div class="dd-head"><span>{g.titel}</span><small>{g.kurz}</small></div>
                    {anker.filter((a) => a.gruppe === g.id).map((a) => (
                      <a class="dd-link" href={href(a.slug)} aria-current={a.slug === slug ? 'page' : undefined}>
                        <span class="dd-icon"><Icon name={a.icon} size={18} /></span>
                        <span class="dd-text"><strong>{a.titel}</strong><small>{a.kurz}</small></span>
                      </a>
                    ))}
                  </div>
                ))}
                <div class="dd-extra">
                  <a class="dd-ziel" href={href(ziel.slug)} aria-current={slug === ziel.slug ? 'page' : undefined}>
                    <span class="dd-icon"><Icon name={ziel.icon} size={18} /></span>
                    <span class="dd-text"><small>Das Ziel</small><strong>{ziel.titel}</strong></span>
                  </a>
                  <a class="dd-ziel" href={href(stunde.slug)} aria-current={slug === stunde.slug ? 'page' : undefined}>
                    <span class="dd-icon"><Icon name={stunde.icon} size={18} /></span>
                    <span class="dd-text"><small>Im Alltag</small><strong>{stunde.titel}</strong></span>
                  </a>
                  <a class="dd-ziel" href={href(kompakt.slug)} aria-current={Astro.url.pathname.includes(kompakt.slug) ? 'page' : undefined}>
                    <span class="dd-icon"><Icon name={kompakt.icon} size={18} /></span>
                    <span class="dd-text"><small>Zum Ausdrucken</small><strong>{kompakt.titel}</strong></span>
                  </a>
                </div>
              </div>
            </div>
            <a class="nav-link" href={href('material')} aria-current={Astro.url.pathname.includes('/material') ? 'page' : undefined}>Material</a>
            <a class="nav-link nav-only-mobile" href={href('quellen')}>Quellen</a>
          </nav>
          <button class="icon-btn theme-toggle" type="button" aria-label="Hell oder dunkel umschalten" title="Hell / Dunkel">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <button class="icon-btn nav-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menü">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="wrap">
      {slug && (
        <section class="hero">
          {heroIcon && <span class="icon-badge icon-badge-lg"><Icon name={heroIcon} size={28} /></span>}
          <div class="eyebrow">{eyebrow ?? `Anker ${i + 1} von ${anker.length}`}</div>
          <h1>{title}</h1>
          {lead && <p class="lead">{lead}</p>}
        </section>
      )}
      <slot />
      {slug && (
        <nav class="pager" aria-label="Weiterblättern">
          <a class="prev" href={prev ? href(prev.slug) : base}>
            <span class="pager-arrow"><Icon name="arrow-left" size={18} /></span>
            <span class="pager-text"><small>Zurück</small><span>{prev ? prev.titel : 'Übersicht'}</span></span>
          </a>
          <a class="next" href={next ? href(next.slug) : href('quellen')}>
            <span class="pager-text"><small>Weiter</small><span>{next ? next.titel : 'Quellen'}</span></span>
            <span class="pager-arrow"><Icon name="arrow-right" size={18} /></span>
          </a>
        </nav>
      )}
    </main>

    <footer class="site-foot">
      <div class="wrap">
        Mein Klassenmanagement-System · laufender Entwurf, Stand {new Date().toLocaleDateString('de-AT', { month: 'long', year: 'numeric' })} · <a href={href('quellen')}>Quellen</a>
      </div>
    </footer>

    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', t);
        try { localStorage.setItem('theme', t); } catch (e) {}
      });
      // Dropdown „System“: Klick öffnet/schließt, Escape und Klick daneben schließen.
      const dd = document.querySelector('.dd');
      const ddBtn = document.querySelector('.dd-btn');
      const setDd = (open) => { dd?.classList.toggle('open', open); ddBtn?.setAttribute('aria-expanded', String(open)); };
      ddBtn?.addEventListener('click', (e) => { e.stopPropagation(); setDd(!dd?.classList.contains('open')); });
      document.addEventListener('click', (e) => { if (dd && !dd.contains(e.target)) setDd(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setDd(false); ddBtn?.focus(); } });
      const btn = document.querySelector('.nav-toggle');
      const nav = document.getElementById('nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
